{
  "manifest_version": 3,
  "name": "Claude ShareChat",
  "version": "1.0.0",
  "description": "Import Claude conversations to ShareChat with one click. Filter, redact, and share your chats effortlessly.",

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Claude ShareChat"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://claudesharechat.vercel.app/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": ["sharechat_bridge.js"],
      "run_at": "document_start"
    }
  ],

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],

  "host_permissions": [
    "https://claude.ai/*",
    "https://claudesharechat.vercel.app/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],

  "web_accessible_resources": [
    {
      "resources": ["popup/*", "icons/*"],
      "matches": ["https://claude.ai/*"]
    }
  ]
}
